{
  "name": "phreshos",
  "displayName": "PhreshOS",
  "version": "0.1.43",
  "description": "The PhreshOS server, desktop, and authoritative system runtime.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhreshOS/system.git"
  },
  "bugs": {
    "url": "https://github.com/PhreshOS/system/issues"
  },
  "homepage": "https://github.com/PhreshOS/system#readme",
  "keywords": [
    "phreshos",
    "operating-system",
    "web-desktop"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit",
    "dev": "vite-node scripts/dev.ts",
    "build": "vite-node scripts/build.ts",
    "start": "node --run build && node dist/server/main.js",
    "pack": "node --run build && vite-node scripts/pack.ts",
    "verify:contracts": "vite-node scripts/verify-contracts.ts",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify": "node --run check && node --run verify:contracts && node --run verify:distribution"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@msgpack/msgpack": "^3.1.3",
    "cfonts": "^3.3.1",
    "get-port": "^7.2.0",
    "gsap": "^3.15.0",
    "hono": "^4.13.2",
    "keyv": "^5.6.0",
    "node-rsa": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@phreshos/core": "^0.1.22",
    "@phreshos/react-ui": "^0.1.11",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "adm-zip": "^0.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0"
  }
}
