{
  "name": "phreshos",
  "displayName": "PhreshOS",
  "version": "0.1.78",
  "description": "The PhreshOS server, desktop, and authoritative system runtime.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhreshOS/system.git"
  },
  "bugs": {
    "url": "https://github.com/PhreshOS/system/issues"
  },
  "homepage": "https://github.com/PhreshOS/system#readme",
  "keywords": [
    "phreshos",
    "operating-system",
    "web-desktop"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit",
    "dev": "NODE_ENV=development vite-node scripts/dev.ts",
    "build": "vite-node scripts/build.ts",
    "start": "node --run build && NODE_ENV=development node dist/server/main.js",
    "pack": "node --run build && vite-node scripts/pack.ts",
    "verify": "node --run check && node --run build && node --run test",
    "test": "vitest run --project default"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "@phreshos/core": "^0.1.55",
    "@phreshos/react-ui": "^0.1.30",
    "@the-link/core": "^0.3.1",
    "@the-link/http": "^0.1.1",
    "@the-link/ipc": "^0.2.1",
    "@the-link/messagepack": "^0.1.0",
    "@the-link/react": "^0.2.0",
    "cfonts": "^3.3.1",
    "hono": "^4.13.8",
    "keyv": "^5.6.0",
    "motion": "^13.4.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "web-streams-polyfill": "^4.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
